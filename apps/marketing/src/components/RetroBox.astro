---
import stableIcon from "../../../../assets/prod/black-universal-1024.png";
import nightlyIcon from "../../../../assets/nightly/nightly-universal-1024.png";

interface Props {
  image: string;
  alt: string;
  sizes: string;
  eager?: boolean;
}

const { image, alt, sizes, eager = false } = Astro.props;
const icon = image.includes("nightly") ? nightlyIcon : stableIcon;
---

<img
  src={icon.src}
  {sizes}
  {alt}
  width="1024"
  height="1024"
  loading={eager ? "eager" : "lazy"}
  fetchpriority={eager ? "high" : "auto"}
  decoding="async"
/>
