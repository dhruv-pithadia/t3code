# Optional Yantrix-owned cloud services. Local development needs none of these.
# Configure your own accounts before enabling cloud features.
# Do not add server-side secrets to this file.

# Production Clerk instance. To use your own, get these from the Clerk Dashboard
# under API keys, JWT templates, and OAuth applications.
# YANTRIX_CLERK_PUBLISHABLE_KEY=
# YANTRIX_CLERK_JWT_TEMPLATE=
# YANTRIX_CLERK_CLI_OAUTH_CLIENT_ID=

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in YANTRIX_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# YANTRIX_APPLE_TEAM_ID=ABC1234567
# YANTRIX_MACOS_PROVISIONING_PROFILE=/absolute/path/to/yantrix.provisionprofile
# YANTRIX_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Production relay. For a self-hosted relay, `infra/relay` deploys update it
# automatically.
# YANTRIX_RELAY_URL=https://relay.example.com

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to https://app.yantrix.invalid; override to test against a staging deployment.
# YANTRIX_HOSTED_APP_URL=https://nightly.app.yantrix.invalid

# Public, ingest-only mobile OpenTelemetry configuration.
# YANTRIX_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# YANTRIX_MOBILE_OTLP_TRACES_DATASET=yantrix-mobile-traces-dev
# YANTRIX_MOBILE_OTLP_TRACES_TOKEN=xaat-...
